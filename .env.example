# ──────────────────────────────────────────────────────────────
# ChainLogger — Environment Configuration
# ──────────────────────────────────────────────────────────────
# Copy this file to .env.local (frontend vars) and .env (Foundry vars),
# then fill in the values.
#
#   .env.local  → Next.js frontend (gitignored, never commit)
#   .env        → Foundry deploy/verification (gitignored, never commit)
# ──────────────────────────────────────────────────────────────

# ─── Frontend (Next.js) ───────────────────────────────────────
# These are exposed to the browser via NEXT_PUBLIC_ prefix.
# Put them in .env.local.

# Deployed ChainLogger contract address (from forge deploy output)
NEXT_PUBLIC_CONTRACT_ADDRESS=

# WalletConnect Project ID — create one at cloud.walletconnect.com
# (optional: only needed if using WalletConnect mobile wallets)
NEXT_PUBLIC_WALLETCONNECT_ID=

# Alchemy RPC for Polygon (used by wagmi for read calls).
# Falls back to a public endpoint if empty, but Alchemy is recommended.
# Get one at alchemy.com
NEXT_PUBLIC_ALCHEMY_POLYGON_RPC=

# IPFS gateway for resolving CIDs (Pinata default shown)
NEXT_PUBLIC_IPFS_GATEWAY=https://gateway.pinata.cloud/ipfs/

# Pinata JWT for uploading files to IPFS — get one at app.pinata.cloud → API Keys
NEXT_PUBLIC_PINATA_JWT=

# ─── Supabase ─────────────────────────────────────────────────
# Get these from your Supabase project: Settings → API

# Supabase project URL (e.g. https://xyz.supabase.co)
NEXT_PUBLIC_SUPABASE_URL=

# Supabase anon/public key (the one labeled "anon" — NOT service_role)
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=

# ─── Deployment (Foundry / forge) ─────────────────────────────
# These are server-side only — they do NOT need NEXT_PUBLIC_ prefix.
# Put them in .env (not .env.local).

# Deployer wallet private key (create a dedicated dev wallet, never use a mainnet key)
PRIVATE_KEY=

# Polygon Amoy RPC URL (for testnet deployment and verification)
POLYGON_AMOY_RPC_URL=https://rpc-amoy.polygon.technology

# Polygon mainnet RPC URL (for future production deployment)
POLYGON_MAINNET_RPC_URL=https://polygon-rpc.com

# Polygonscan API key — get one at polygonscan.com/apis
# Used for contract verification after deploy
POLYGONSCAN_API_KEY=
